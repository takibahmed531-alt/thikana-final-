rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // Reusable Security Helpers
    // ----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ----------------------------------------------------
    // Entity Schema Validators
    // ----------------------------------------------------
    function isValidPublicProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'isVerified'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'isVerified'])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.role is string
        && (data.role in ['tenant', 'landlord', 'agent'])
        && data.isVerified is bool;
    }

    function isValidPrivateUser(data, uid) {
      return data.keys().hasAll(['uid', 'phoneNumber', 'nidNumber', 'dateOfBirth', 'hiddenAddress'])
        && data.keys().hasOnly(['uid', 'phoneNumber', 'nidNumber', 'dateOfBirth', 'hiddenAddress', 'preferences'])
        && data.uid == uid
        && data.phoneNumber is string && data.phoneNumber.size() <= 30
        && data.nidNumber is string && data.nidNumber.size() <= 30
        && data.dateOfBirth is string && data.dateOfBirth.size() <= 30
        && data.hiddenAddress is string && data.hiddenAddress.size() <= 300
        && (!('preferences' in data) || (
          data.preferences is map
          && data.preferences.keys().hasAll(['theme', 'notificationsEnabled'])
          && data.preferences.keys().hasOnly(['theme', 'notificationsEnabled'])
          && data.preferences.theme is string
          && (data.preferences.theme in ['light', 'dark'])
          && data.preferences.notificationsEnabled is bool
        ));
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['propertyId', 'landlordUid', 'title', 'rentAmount', 'category', 'location', 'amenities', 'createdAt', 'genderPreference', 'status', 'coordinates'])
        && (('images' in data) || ('imageUrls' in data))
        && data.keys().hasOnly(['propertyId', 'landlordUid', 'title', 'rentAmount', 'category', 'location', 'amenities', 'images', 'imageUrls', 'createdAt', 'genderPreference', 'availableSeats', 'status', 'coordinates', 'adId', 'occupationPreference', 'minAge', 'maxAge'])
        && isValidId(data.propertyId)
        && isValidId(data.landlordUid)
        && (!('adId' in data) || (data.adId is string && data.adId.size() >= 5))
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 200
        && data.rentAmount is number && data.rentAmount >= 0
        && data.category is string && (data.category in ['apartment', 'house', 'bachelor_sublet', 'family_unit', 'commercial', 'hostel'])
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 300
        && data.amenities is list && data.amenities.size() <= 50
        && (!('images' in data) || (data.images is list && data.images.size() <= 30))
        && (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 30))
        && data.genderPreference is string && (data.genderPreference in ['Any', 'Male', 'Female'])
        && (!('availableSeats' in data) || (data.availableSeats is number && data.availableSeats >= 0))
        && data.status is string && (data.status in ['available', 'rented'])
        && data.coordinates is list && data.coordinates.size() == 2 && data.coordinates[0] is number && data.coordinates[1] is number
        && data.createdAt is timestamp
        && (!('occupationPreference' in data) || data.occupationPreference is string)
        && (!('minAge' in data) || data.minAge is number)
        && (!('maxAge' in data) || data.maxAge is number);
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reportId', 'reporterUid', 'targetId', 'targetType', 'reason', 'status', 'createdAt'])
        && data.keys().hasOnly(['reportId', 'reporterUid', 'targetId', 'targetType', 'reason', 'description', 'status', 'createdAt'])
        && isValidId(data.reportId)
        && isValidId(data.reporterUid)
        && isValidId(data.targetId)
        && (data.targetType in ['property', 'user'])
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && data.status == 'pending'
        && data.createdAt is timestamp;
    }

    function isValidChatMessage(data, messageId) {
      return data.messageId == messageId
        && data.senderUid == request.auth.uid
        && data.text is string
        && data.text.size() <= 2000
        && (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000));
    }

    function isValidSupportTicket(data, ticketId) {
      return data.keys().hasAll(['ticketId', 'userUid', 'email', 'subject', 'message', 'createdAt', 'status'])
        && data.keys().hasOnly(['ticketId', 'userUid', 'email', 'subject', 'message', 'createdAt', 'status'])
        && isValidId(data.ticketId)
        && data.ticketId == ticketId
        && isValidId(data.userUid)
        && data.userUid == request.auth.uid
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && (data.createdAt is string || data.createdAt is timestamp)
        && (data.status in ['open', 'in_progress', 'resolved', 'closed']);
    }

    // ----------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------

    // 1. 'publicProfiles'
    // Readable by anyone, writable ONLY by the document owner
    match /publicProfiles/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && isValidPublicProfile(incoming(), uid)
        // Prevent self-assigning verified status on creation
        && incoming().isVerified == false;

      allow update: if isOwner(uid)
        && isValidPublicProfile(incoming(), uid)
        && incoming().uid == existing().uid
        // Prevent user from elevating their own verification status
        && incoming().isVerified == existing().isVerified;

      allow delete: if isOwner(uid);
    }

    // 2. 'privateUsers'
    // Strictly readable and writable ONLY by the authenticated user whose uid matches document ID
    match /privateUsers/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isValidPrivateUser(incoming(), uid);

      allow update: if isOwner(uid)
        && isValidPrivateUser(incoming(), uid)
        && incoming().uid == existing().uid;

      allow delete: if isOwner(uid);
    }

    // 3. 'properties'
    // Readable by anyone, writable ONLY by the landlord who owns the listing
    match /properties/{propertyId} {
      allow read: if true;

      allow create: if isSignedIn()
        && incoming().landlordUid == request.auth.uid
        && incoming().propertyId == propertyId
        && isValidProperty(incoming())
        && incoming().createdAt == request.time;

      allow update: if isSignedIn()
        && existing().landlordUid == request.auth.uid
        && incoming().landlordUid == existing().landlordUid
        && incoming().propertyId == existing().propertyId
        && incoming().createdAt == existing().createdAt
        && isValidProperty(incoming());

      allow delete: if isSignedIn()
        && existing().landlordUid == request.auth.uid;
    }

    // 4. 'conversations'
    // Readable and writable only by the conversation participants (tenant and landlord)
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && (request.auth.uid in incoming().participants)
        && incoming().participants.size() == 2
        && (!('deletedBy' in incoming()) || (incoming().deletedBy is list && incoming().deletedBy.size() <= 2))
        && (!('starredBy' in incoming()) || (incoming().starredBy is list && incoming().starredBy.size() <= 2));

      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.participants)
        && incoming().participants == existing().participants
        && (!('deletedBy' in incoming()) || (incoming().deletedBy is list && incoming().deletedBy.size() <= 2))
        && (!('starredBy' in incoming()) || (incoming().starredBy is list && incoming().starredBy.size() <= 2));

      allow delete: if false;

      // Subcollection 'messages'
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        allow create: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          && isValidChatMessage(incoming(), messageId);

        allow update, delete: if false;
      }
    }

    // 5. 'reports'
    // Allow any authenticated user to create a report.
    // Restrict read, update, and delete to admins only (for now, allow read, update, delete: if false;)
    match /reports/{reportId} {
      allow read: if false;

      allow create: if isSignedIn()
        && incoming().reporterUid == request.auth.uid
        && incoming().reportId == reportId
        && isValidReport(incoming())
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // 6. 'searchAlerts'
    // Allow authenticated users to create, read, update and delete their own search alerts
    match /searchAlerts/{alertId} {
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;

      allow create: if isSignedIn()
        && incoming().userUid == request.auth.uid
        && incoming().area is string && incoming().area.size() <= 200
        && incoming().category is string && incoming().category.size() <= 100
        && (!('userEmail' in incoming()) || (incoming().userEmail is string && incoming().userEmail.size() <= 200))
        && (!('minRent' in incoming()) || (incoming().minRent is number && incoming().minRent >= 0))
        && (!('maxRent' in incoming()) || (incoming().maxRent is number && incoming().maxRent >= 0))
        && (!('genderPreference' in incoming()) || (incoming().genderPreference is string && (incoming().genderPreference in ['Any', 'Male', 'Female'])))
        && (!('emailNotifications' in incoming()) || (incoming().emailNotifications is bool))
        && incoming().createdAt is timestamp;

      allow update: if isSignedIn() && resource.data.userUid == request.auth.uid
        && incoming().userUid == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.userUid == request.auth.uid;
    }

    // 7. 'notificationLogs'
    // Delivery records of automated alerts. Recipient can view their logs.
    match /notificationLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 8. 'supportTickets'
    // Allow authenticated users to create support tickets and read their own tickets
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;

      allow create: if isSignedIn()
        && incoming().userUid == request.auth.uid
        && incoming().ticketId == ticketId
        && isValidSupportTicket(incoming(), ticketId);

      allow update, delete: if false;
    }

    // 9. 'test'
    // Connection health-check verification
    match /test/{docId} {
      allow read: if true;
    }
  }
}
