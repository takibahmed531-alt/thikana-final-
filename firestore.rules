rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Properties: public read, authenticated write
    match /properties/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public Profiles: public read, authenticated write
    match /publicProfiles/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Test health check: public read, authenticated write
    match /test/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other documents and subcollections (conversations, messages, privateUsers, reports, searchAlerts, supportTickets)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
